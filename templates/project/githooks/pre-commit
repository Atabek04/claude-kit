#!/bin/bash
# Runs claude-kit's comment gate on staged lines; CI runs the same script, so a missing clone only warns.
GATE="${CLAUDE_KIT:-$HOME/claude-kit}/plugin/scripts/no-slop.sh"

if [ ! -x "$GATE" ]; then
    echo "pre-commit: $GATE not found, comment gate skipped (CI still runs it). Clone Atabek04/claude-kit." >&2
    exit 0
fi

exec "$GATE" --staged
